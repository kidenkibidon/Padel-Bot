[Unit]
Description=Padel Escape Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=padelbot
Group=padelbot
WorkingDirectory=/opt/padel-escape
ExecStart=/usr/bin/python3 /opt/padel-escape/bot.py --env /opt/padel-escape/.env
Restart=on-failure
RestartSec=10
TimeoutStopSec=50
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/padel-escape/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
